[Unit]
Description=Pawhub Express API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pawhub
Group=pawhub
WorkingDirectory=/opt/pawhub/server
Environment=NODE_ENV=production
EnvironmentFile=/etc/pawhub/server.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pawhub
UMask=0077

[Install]
WantedBy=multi-user.target
