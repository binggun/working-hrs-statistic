DATABASE_URL=postgresql://pawhub:CHANGE_ME@127.0.0.1:5432/pawhub
PORT=3000
WEB_ORIGIN=https://manager.example.com
SESSION_HOURS=12
AWS_REGION=ap-southeast-2
PHOTO_BUCKET=pawhub-private-photos
MAIL_FROM=hello@example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# false: STARTTLS (587); true: implicit TLS (465).
SMTP_SECURE=false
SMTP_USER=resend
# Resend API key (not your mailbox password); verify MAIL_FROM domain in Resend first.
SMTP_PASS=
# Generate securely: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_ENCRYPTION_KEY=
# Only needed for the one-time bootstrap command; remove afterwards.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Photon-compatible address lookup endpoint; override for a private provider.
GEOCODING_URL=https://photon.komoot.io/api/

# local: private server/data/photos directory; s3: PHOTO_BUCKET and AWS credentials required.
PHOTO_STORAGE=s3
